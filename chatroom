!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title>哨向联盟·离群之鸟</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#00CCFF',
                        secondary: '#FF00CC',
                        accent: '#00FF9C',
                        dark: '#090E1F',
                        'dark-light': '#121A2C',
                        light: '#E6F7FF',
                    },
                    fontFamily: {
                        cyber: ['Inter', 'Segoe UI', 'Roboto', 'Microsoft YaHei', 'sans-serif'],
                    },
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer utilities {
            .text-shadow { text-shadow: 0 0 10px rgba(0,204,255,0.8); }
            .bg-glass { background: rgba(9,14,31,0.85); backdrop-filter: blur(12px); }
            .border-cyber { border:1px solid rgba(0,204,255,0.5); box-shadow:0 0 15px rgba(0,204,255,0.25); }
            .bg-grid {
                background-image: linear-gradient(rgba(18,26,44,0.95),rgba(18,26,44,0.95)),
                linear-gradient(to right,rgba(0,204,255,0.05) 1px,transparent 1px),
                linear-gradient(to bottom,rgba(0,204,255,0.05) 1px,transparent 1px);
                background-size:100% 100%,24px 24px,24px 24px;
            }
            .scrollbar-hide::-webkit-scrollbar { display:none; }
            .scrollbar-hide { -ms-overflow-style:none; scrollbar-width:none; }
            .typing::after { content:"|"; animation:blink 1s infinite; }
            @keyframes blink { 50%{opacity:0;} }
            html, body { height:100%; overflow-x:hidden; }
        }
    </style>
</head>
<body class="bg-dark bg-grid text-light font-cyber scrollbar-hide">

<!-- 登录界面（手机全屏） -->
<div id="login" class="h-screen flex flex-col items-center justify-center p-5">
    <div class="bg-dark-light border-cyber rounded-xl p-6 w-full max-w-sm">
        <h1 class="text-3xl font-bold text-primary text-shadow text-center mb-4">哨向联盟·离群之鸟</h1>
        <p class="text-gray-400 text-center mb-6 text-sm">文游剧本杀·适配手机浏览器</p>

        <div class="mb-4">
            <label class="block text-sm mb-1">房间号</label>
            <input id="roomId" type="text" class="w-full bg-dark border border-primary/50 rounded-lg p-3 text-base outline-none focus:border-primary" placeholder="输入房间号">
        </div>

        <div class="mb-5">
            <label class="block text-sm mb-1">选择角色</label>
            <select id="roleSelect" class="w-full bg-dark border border-primary/50 rounded-lg p-3 text-base outline-none">
                <option>花海</option>
                <option>清融</option>
                <option>暖阳</option>
                <option>一诺</option>
                <option>钎城</option>
                <option>九尾</option>
            </select>
        </div>

        <button onclick="enterRoom()" class="w-full bg-primary text-dark font-bold py-3 rounded-lg text-lg">进入房间</button>
    </div>
</div>

<!-- 游戏界面（手机竖屏优化） -->
<div id="game" class="hidden h-screen flex flex-col">
    <!-- 顶部信息 -->
    <div class="bg-glass border-b border-cyber p-3 flex justify-between items-center">
        <div>
            <div class="text-xs text-gray-400">房间号</div>
            <div id="showRoom" class="text-primary font-bold">—</div>
        </div>
        <div class="text-right">
            <div class="text-xs text-gray-400">角色</div>
            <div id="showRole" class="text-secondary font-bold">—</div>
        </div>
    </div>

    <!-- 角色信息 -->
    <div class="bg-dark-light p-3 border-b border-cyber">
        <div id="roleInfo" class="text-sm text-gray-300">加载中…</div>
    </div>

    <!-- 聊天区域（手机核心） -->
    <div id="chatBox" class="flex-1 p-3 overflow-y-auto scrollbar-hide text-base leading-relaxed"></div>

    <!-- 底部输入框（固定在手机底部） -->
    <div class="bg-glass border-t border-cyber p-2 flex gap-2">
        <input id="msgInput"
               class="flex-1 bg-dark border border-primary/50 rounded-lg px-3 py-2.5 text-base outline-none"
               placeholder="输入行动/对话…">
        <button onclick="sendMsg()"
                class="bg-primary text-dark px-4 py-2.5 rounded-lg font-bold">发送</button>
    </div>
</div>

<script>
const roleData = {
    "花海":"S级哨兵·近战型 | 武汉塔 | 第三届首席",
    "清融":"S级向导·功能型 | 武汉塔 | 第五届首席",
    "暖阳":"S级哨兵·近战型 | 北京塔 | 第四届首席",
    "一诺":"S级向导·进攻型 | 成都塔 | 第四届首席",
    "钎城":"S级哨兵·控场型 | 广州塔 | 第三、四、五届亚军",
    "九尾":"S级向导·功能型 | 广州塔 | 第三、四、五届亚军"
};

function enterRoom() {
    let roomId = document.getElementById('roomId').value.trim();
    let role = document.getElementById('roleSelect').value;
    if(!roomId) { alert("请输入房间号"); return; }

    document.getElementById('login').classList.add('hidden');
    document.getElementById('game').classList.remove('hidden');
    document.getElementById('showRoom').innerText = roomId;
    document.getElementById('showRole').innerText = role;
    document.getElementById('roleInfo').innerText = roleData[role];

    loadRoomMsg();
    addSystemMsg("你已进入房间：" + roomId);
}

function sendMsg() {
    let input = document.getElementById('msgInput');
    let msg = input.value.trim();
    if(!msg) return;
    let role = document.getElementById('showRole').innerText;
    let roomId = document.getElementById('showRoom').innerText;

    let data = { role, msg, time:new Date().toLocaleTimeString() };
    saveMsgToRoom(roomId, data);
    addMsg(data);
    input.value = "";
}

function saveMsgToRoom(roomId, data) {
    let key = "ROOM_"+roomId;
    let list = JSON.parse(localStorage.getItem(key) || "[]");
    list.push(data);
    localStorage.setItem(key, JSON.stringify(list));
}

function loadRoomMsg() {
    let roomId = document.getElementById('showRoom').innerText;
    let list = JSON.parse(localStorage.getItem("ROOM_"+roomId) || "[]");
    list.forEach(item => addMsg(item));
}

function addMsg(data) {
    let box = document.getElementById('chatBox');
    let div = document.createElement('div');
    div.className = "mb-3";
    div.innerHTML = `<span class="text-accent text-xs">${data.time}</span>
                     <span class="text-secondary font-bold">${data.role}</span>：
                     <span class="text-light">${data.msg}</span>`;
    box.appendChild(div);
    box.scrollTop = box.scrollHeight;
}

function addSystemMsg(text) {
    let box = document.getElementById('chatBox');
    let div = document.createElement('div');
    div.className = "mb-3 text-primary text-center typing text-sm";
    div.innerText = text;
    box.appendChild(div);
    box.scrollTop = box.scrollHeight;
}

document.getElementById('msgInput').addEventListener('keypress', e=>{
    if(e.key === 'Enter') sendMsg();
});
</script>
</body>
</html>
